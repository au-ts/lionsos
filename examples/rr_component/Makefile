# Makefile is generated by setup.py
BUILD_DIR := build

ifndef RR_TEST_TARGET
    $(error Please specify RR_TEST_TARGET as one of the following options: $(shell ls tests))
endif

${BUILD_DIR}/Makefile: tests/$(RR_TEST_TARGET)/rr_component.mk
	python setup.py --test-target=$(RR_TEST_TARGET)

%: ${BUILD_DIR}/Makefile
	${MAKE} -C ${BUILD_DIR} MICROKIT_SDK=${MICROKIT_SDK} $(notdir $@)
